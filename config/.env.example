# .env.example — Hermes Control Plane
# Copy to .env and fill in your keys

# ── hermes-agent ──────────────────────────────────────────────────
# Already configured in ~/.hermes/config.yaml and ~/.hermes/.env
# HERMES_AGENT_DIR=~/.hermes/hermes-agent

# ── hermes-webui ──────────────────────────────────────────────────
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_HOST=127.0.0.1
# HERMES_WEBUI_PASSWORD=            # Set for non-localhost access

# ── gbrain ────────────────────────────────────────────────────────
# OPENAI_API_KEY=                    # For vector embeddings (text-embedding-3-large)
# ANTHROPIC_API_KEY=                 # For multi-query expansion + LLM chunking
# Optional: Supabase for production scale
# GBRAIN_SUPABASE_URL=
# GBRAIN_SUPABASE_KEY=

# ── browser-use ───────────────────────────────────────────────────
# BROWSER_USE_API_KEY=               # Get from https://cloud.browser-use.com/settings?tab=api-keys&new=1

# ── self-evolution ────────────────────────────────────────────────
HERMES_AGENT_REPO=~/.hermes/hermes-agent
# OPENAI_API_KEY=                    # Same as gbrain — DSPy/GEPA uses this for LLM calls